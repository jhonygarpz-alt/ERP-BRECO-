# ============================================================================
# Centinela Digital -- variables de entorno.
# Copia este archivo a ".env" y llena los valores reales. Nunca subas ".env"
# al repositorio (ya esta en .gitignore).
# ============================================================================

# ---- Base de datos ----
DATABASE_URL=postgresql+psycopg://centinela:centinela@localhost:5432/centinela

# ---- Redis (colas, temporizadores, idempotencia de webhooks) ----
REDIS_URL=redis://localhost:6379/0

# ---- Zona horaria de toda la operacion ----
TIMEZONE=America/Mexico_City

# ---- Proveedor de GPS activo: "mock" | "wialon" | "traccar" ----
GPS_PROVIDER=mock
WIALON_TOKEN=
WIALON_BASE_URL=
TRACCAR_URL=
TRACCAR_USER=
TRACCAR_PASSWORD=

# ---- Canal de mensajeria activo: "console" | "whatsapp_cloud" | "twilio" ----
MESSAGING_CHANNEL=console
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=

# ---- Claude API (agente conversacional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Transcripcion de notas de voz: "whisper_api" | "none" ----
STT_PROVIDER=none
OPENAI_API_KEY=

# ---- Calculo de ETA: "haversine" | "osrm" | "google_routes" ----
ETA_PROVIDER=haversine
OSRM_BASE_URL=http://localhost:5000
GOOGLE_ROUTES_API_KEY=

# ---- Palabra clave de coaccion por defecto (configurable tambien por empresa) ----
PALABRA_COACCION_DEFAULT=manzana

# ---- Panel web ----
DASHBOARD_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo

# ---- Logs ----
LOG_LEVEL=INFO
